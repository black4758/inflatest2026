{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "🟢 백엔드 상태 (UP/DOWN)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "index": 1, "text": "DOWN (장애)" },
                "1": { "color": "green", "index": 0, "text": "UP (정상 가동)" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "up{job=\"spring-boot-backend\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "⏱️ 서버 가동 시간 (Uptime)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "expr": "process_uptime_seconds{job=\"spring-boot-backend\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "🔥 시스템 CPU 사용률",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "system_cpu_usage{job=\"spring-boot-backend\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "🧠 JVM 힙 메모리 사용률",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.75 },
              { "color": "red", "value": 0.9 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{job=\"spring-boot-backend\", area=\"heap\"}) / sum(jvm_memory_max_bytes{job=\"spring-boot-backend\", area=\"heap\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "🗄️ MySQL 활성 커넥션 (HikariCP)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 9 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active{job=\"spring-boot-backend\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "🚨 백엔드 ERROR 로그 발생 건수",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "expr": "sum(logback_events_total{job=\"spring-boot-backend\", level=\"error\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "🌐 초당 게시판 API 요청 수 (RPS - 헬스체크 제외)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "expr": "sum by (method, uri, status) (rate(http_server_requests_seconds_count{job=\"spring-boot-backend\", uri!~\"/actuator/.*\"}[1m]))",
          "legendFormat": "{{method}} {{uri}} ({{status}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "⚡ 게시판 API 평균 응답 시간 (Latency - 헬스체크 제외)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_sum{job=\"spring-boot-backend\", uri!~\"/actuator/.*\"}[1m]) / rate(http_server_requests_seconds_count{job=\"spring-boot-backend\", uri!~\"/actuator/.*\"}[1m])",
          "legendFormat": "{{method}} {{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "💻 CPU 사용률 추이 (시스템 vs JVM 프로세스)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "expr": "system_cpu_usage{job=\"spring-boot-backend\"}",
          "legendFormat": "전체 시스템 CPU",
          "refId": "A"
        },
        {
          "expr": "process_cpu_usage{job=\"spring-boot-backend\"}",
          "legendFormat": "Spring Boot JVM CPU",
          "refId": "B"
        }
      ]
    },
    {
      "id": 10,
      "title": "🧠 JVM 힙 메모리 상세 (Used / Committed / Max)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{job=\"spring-boot-backend\", area=\"heap\"})",
          "legendFormat": "사용 중 (Used Heap)",
          "refId": "A"
        },
        {
          "expr": "sum(jvm_memory_committed_bytes{job=\"spring-boot-backend\", area=\"heap\"})",
          "legendFormat": "할당됨 (Committed Heap)",
          "refId": "B"
        },
        {
          "expr": "sum(jvm_memory_max_bytes{job=\"spring-boot-backend\", area=\"heap\"})",
          "legendFormat": "최대 한도 (Max Heap)",
          "refId": "C"
        }
      ]
    },
    {
      "id": 11,
      "title": "🗄️ MySQL HikariCP 커넥션 풀 상태",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active{job=\"spring-boot-backend\"}",
          "legendFormat": "활성 (Active)",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_idle{job=\"spring-boot-backend\"}",
          "legendFormat": "유휴 대기 (Idle)",
          "refId": "B"
        },
        {
          "expr": "hikaricp_connections_pending{job=\"spring-boot-backend\"}",
          "legendFormat": "지연 대기 (Pending)",
          "refId": "C"
        },
        {
          "expr": "hikaricp_connections_max{job=\"spring-boot-backend\"}",
          "legendFormat": "최대 풀 크기 (Max)",
          "refId": "D"
        }
      ]
    },
    {
      "id": 12,
      "title": "📜 Spring Boot 백엔드 실시간 로그 (Blue / Green 통합)",
      "type": "logs",
      "gridPos": { "h": 10, "w": 14, "x": 0, "y": 20 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{service=~\"backend-blue|backend-green\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "🌐 Nginx Gateway 사용자 접속 로그 (/actuator 제외)",
      "type": "logs",
      "gridPos": { "h": 10, "w": 10, "x": 14, "y": 20 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{service=\"gateway\"} != \"/actuator/\"",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["spring-boot", "mysql", "infra"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "Asia/Seoul",
  "title": "🚀 Infra Test - Spring Boot & MySQL 실시간 모니터링",
  "uid": "spring-boot-infra",
  "version": 1
}
