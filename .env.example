# Gateway (Nginx Reverse Proxy)
GATEWAY_PORT=80

# MySQL Database Configuration (Internal Docker Network Only - 3306 Closed Externally)
MYSQL_DATABASE=board_db
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_USER=board_user
MYSQL_PASSWORD=your_app_password_here

# Grafana Monitoring (Accessed via https://infla.koreacentral.cloudapp.azure.com/grafana/)
GRAFANA_ADMIN_USER=your_grafana_user_here
GRAFANA_ADMIN_PASSWORD=your_grafana_password_here

# Slack Webhook URL (배포 알림 & Grafana 24시간 실시간 장애 경보 공용)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
